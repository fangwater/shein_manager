# PostgreSQL connection for the local order database.
DATABASE_URL=postgresql://demo_user:demo_password@127.0.0.1:5432/demo_app

# SHEIN production API base URL for semi-managed/self-operated apps.
SHEIN_API_BASE_URL=https://openapi.sheincorp.com

# SHEIN authorization URL host for production.
SHEIN_AUTH_BASE_URL=https://openapi-sem.sheincorp.com

# App-level credentials from SHEIN developer console.
# Used only for authorization token exchange (/open-api/auth/get-by-token).
SHEIN_APP_ID=your_app_id
SHEIN_APP_SECRET_KEY=your_app_secret_key

# Optional: store-level credentials after authorization.
# If omitted, commands can load credentials from the shein_shops table by --shop-key.
SHEIN_OPEN_KEY_ID=
SHEIN_SECRET_KEY=
SHEIN_SHOP_KEY=default

# Order API defaults. Override from CLI if the API doc requires different names.
SHEIN_ORDER_LIST_METHOD=POST
SHEIN_ORDER_DETAIL_METHOD=POST
SHEIN_ORDER_DETAIL_FIELD=orderNoList
